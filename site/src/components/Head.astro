---
import Default from '@astrojs/starlight/components/Head.astro';
---

<Default><slot /></Default>

<script>
  // Starlight has no Mermaid integration. The rehype plugin in astro.config.mjs
  // turns fenced mermaid blocks into `div.mermaid`; this renders them, re-runs on
  // client-side navigation, and re-themes when the color scheme changes.
  import mermaid from 'mermaid';

  let observing = false;
  let counter = 0;

  function isDark() {
    return document.documentElement.dataset.theme !== 'light';
  }

  async function renderAll() {
    const nodes = Array.from(
      document.querySelectorAll<HTMLElement>('.mermaid:not([data-processed])'),
    );
    if (nodes.length === 0) return;

    mermaid.initialize({
      startOnLoad: false,
      theme: isDark() ? 'dark' : 'default',
      securityLevel: 'strict',
      fontFamily: 'inherit',
    });

    for (const node of nodes) {
      const source = node.dataset.mermaidSource ?? node.textContent ?? '';
      try {
        const { svg } = await mermaid.render(`mermaid-${(counter += 1)}`, source);
        node.innerHTML = svg;
        node.dataset.processed = 'true';
      } catch (error) {
        // A broken diagram must not blank out the page — fall back to the source.
        console.error('Mermaid render failed', error);
        node.textContent = source;
        node.dataset.processed = 'failed';
      }
    }
  }

  function stashSources() {
    for (const node of document.querySelectorAll<HTMLElement>(
      '.mermaid:not([data-mermaid-source])',
    )) {
      node.dataset.mermaidSource = node.textContent ?? '';
    }
  }

  function reRenderForTheme() {
    for (const node of document.querySelectorAll<HTMLElement>('.mermaid[data-processed]')) {
      node.removeAttribute('data-processed');
    }
    void renderAll();
  }

  function boot() {
    stashSources();
    void renderAll();

    if (observing) return;
    observing = true;
    new MutationObserver((records) => {
      if (records.some((record) => record.attributeName === 'data-theme')) reRenderForTheme();
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
